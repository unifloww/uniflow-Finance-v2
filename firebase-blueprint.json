{
  "project": "uniflow-finance",
  "collections": [
    {
      "name": "users",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "email", "type": "string" },
        { "name": "name", "type": "string" },
        { "name": "role", "type": "string" },
        { "name": "status", "type": "string" },
        { "name": "created_at", "type": "timestamp" },
        { "name": "last_login", "type": "timestamp" }
      ],
      "rules": [
        {
          "allow": ["read", "update"],
          "condition": "request.auth != null && request.auth.uid == document"
        },
        {
          "allow": ["create"],
          "condition": "request.auth != null && request.auth.uid == document"
        },
        {
          "allow": ["read", "write"],
          "condition": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'"
        }
      ]
    },
    {
      "name": "accounts",
      "fields": [
        { "name": "user_id", "type": "string" },
        { "name": "name", "type": "string" },
        { "name": "type", "type": "string" },
        { "name": "balance", "type": "number" },
        { "name": "created_at", "type": "timestamp" }
      ],
      "rules": [
        {
          "allow": ["read", "update", "delete"],
          "condition": "request.auth != null && request.auth.uid == resource.data.user_id"
        },
        {
          "allow": ["create"],
          "condition": "request.auth != null && request.auth.uid == request.resource.data.user_id"
        },
        {
          "allow": ["read"],
          "condition": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'"
        }
      ]
    },
    {
      "name": "transactions",
      "fields": [
        { "name": "user_id", "type": "string" },
        { "name": "account_id", "type": "string" },
        { "name": "category_id", "type": "string" },
        { "name": "type", "type": "string" },
        { "name": "amount", "type": "number" },
        { "name": "description", "type": "string" },
        { "name": "date", "type": "timestamp" },
        { "name": "created_at", "type": "timestamp" }
      ],
      "rules": [
        {
          "allow": ["read", "update", "delete"],
          "condition": "request.auth != null && request.auth.uid == resource.data.user_id"
        },
        {
          "allow": ["create"],
          "condition": "request.auth != null && request.auth.uid == request.resource.data.user_id"
        },
        {
          "allow": ["read"],
          "condition": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'"
        }
      ]
    },
    {
      "name": "goals",
      "fields": [
        { "name": "user_id", "type": "string" },
        { "name": "name", "type": "string" },
        { "name": "target_amount", "type": "number" },
        { "name": "current_amount", "type": "number" },
        { "name": "deadline", "type": "timestamp" },
        { "name": "created_at", "type": "timestamp" }
      ],
      "rules": [
        {
          "allow": ["read", "update", "delete"],
          "condition": "request.auth != null && request.auth.uid == resource.data.user_id"
        },
        {
          "allow": ["create"],
          "condition": "request.auth != null && request.auth.uid == request.resource.data.user_id"
        },
        {
          "allow": ["read"],
          "condition": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'"
        }
      ]
    },
    {
      "name": "audit_logs",
      "fields": [
        { "name": "actor_id", "type": "string" },
        { "name": "actor_role", "type": "string" },
        { "name": "action", "type": "string" },
        { "name": "target_type", "type": "string" },
        { "name": "target_id", "type": "string" },
        { "name": "timestamp", "type": "timestamp" }
      ],
      "rules": [
        {
          "allow": ["create"],
          "condition": "request.auth != null && request.auth.uid == request.resource.data.actor_id"
        },
        {
          "allow": ["read", "write"],
          "condition": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'"
        }
      ]
    }
  ]
}
